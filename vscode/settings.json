{
  "window.title": "${activeRepositoryName}${separator}${activeRepositoryBranchName}${separator}${dirty}${activeEditorMedium}${separator}${remoteName}",
  "window.commandCenter": false,
  "workbench.colorTheme": "Visual Studio Dark - C++",
  "workbench.sideBar.location": "right",
  "workbench.startupEditor": "none",
  "workbench.browser.showInTitleBar": false,
  "workbench.layoutControl.enabled": false,
  "workbench.editor.enablePreview": false,
  "explorer.autoReveal": false,
  "editor.detectIndentation": false,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "editor.rulers": [
    80
  ],
  "editor.guides.bracketPairs": true,
  "editor.stickyScroll.enabled": true,
  "editor.linkedEditing": true,
  "editor.formatOnSave": true,
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python-envs.alwaysUseUv": false,
  "python-envs.terminal.autoActivationType": "command",
  "black-formatter.importStrategy": "useBundled",
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file"
  },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_style": "file",
  "C_Cpp.clang_format_fallbackStyle": "none",
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  },
  "extensions.ignoreRecommendations": true,
  "git.autofetch": "all",
  "telemetry.telemetryLevel": "off",
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "chat.titleBar.signIn.enabled": false
}
