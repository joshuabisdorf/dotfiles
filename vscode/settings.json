{
  "window.title": "${activeRepositoryName}${separator}${activeRepositoryBranchName}${separator}${dirty}${activeEditorMedium}${separator}${remoteName}",
  "window.commandCenter": false,
  "workbench.colorTheme": "Visual Studio Dark - C++",
  "workbench.sideBar.location": "right",
  "workbench.startupEditor": "none",
  "workbench.browser.showInTitleBar": false,
  "workbench.layoutControl.enabled": false,
  "workbench.editor.enablePreview": false,
  "editor.detectIndentation": false,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "editor.rulers": [
    80
  ],
  "editor.guides.bracketPairs": true,
  "editor.stickyScroll.enabled": true,
  "editor.linkedEditing": true,
  "editor.formatOnSave": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: Google, DerivePointerAlignment: false, PointerAlignment: Left, ReferenceAlignment: Left }",
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  },
  "extensions.ignoreRecommendations": true,
  "git.autofetch": "all",
  "telemetry.telemetryLevel": "off",
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "chat.titleBar.signIn.enabled": false
}
